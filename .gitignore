# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-electron
dist-ssr
*.local

# electron-builder output — DMG + unpacked .app bundle. Huge (~150MB+)
# and reproducible from source via `npm run package:mac`. GitHub rejects
# pushes containing files >100MB, which the Electron Framework binary
# alone trips. Never commit.
frontend/release/

# quicklook helper build output — compiled .appex bundle assembled by
# quicklook/build.sh. Reproducible from Swift source. Don't commit.
quicklook/build/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files (keep examples committed)
.env
.env.*
backend/.env
!*.env.example
!**/*.env.example
# Public production API base — baked into the client bundle, safe to commit.
!frontend/.env.production

# Local backend runtime data (SQLite/db artifacts)
backend/data/*
!backend/data/.gitkeep

# Claude Code per-project state (permissions, preview launch config, etc.)
.claude/

# Scratch space for personal review notes
red's reviews/

# Generated by frontend/scripts/copy-pdfjs-assets.mjs — pdf.js character
# maps + standard fonts copied from node_modules at predev/prebuild time.
frontend/public/pdfjs/
