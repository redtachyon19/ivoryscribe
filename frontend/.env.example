# Frontend (Vite) environment variables.
# - Production values live in .env.production (committed).
# - For local overrides, copy to .env.local (gitignored).

# Base URL of the backend API. Leave unset in development to auto-resolve to
# http://localhost:<VITE_API_PORT>. Set it for builds that talk to a hosted
# backend (see .env.production).
# VITE_API_URL=https://api.ivoryscribe.com

# Port used for the localhost fallback when VITE_API_URL is not set.
VITE_API_PORT=4000
