PORT=4000
HOST=127.0.0.1
ENABLE_LAN_CORS=false
CLIENT_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000
FRONTEND_PUBLIC_URL=http://localhost:5173

# sqlite (default) or postgres
DB_DIALECT=sqlite
# Used when DB_DIALECT=sqlite
DB_STORAGE=./data/ivoryscribe.sqlite

# --- Postgres ---
# Preferred for hosted Postgres. Railway/Render/Neon/Supabase inject a value
# like this; when set it becomes the connection string AND forces the postgres
# dialect (DB_DIALECT is ignored).
# DATABASE_URL=postgres://user:password@host:5432/ivoryscribe

# Discrete connection settings (used only when DATABASE_URL is not set).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ivoryscribe
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
# Set true for managed Postgres that requires TLS (most cloud hosts).
# Keep false for local Postgres and Railway's private networking.
DB_SSL=false

# safe (default) | alter | force
# safe: never rewrites existing tables
# alter: attempts schema updates (can be risky on sqlite)
# force: drops and recreates all tables
DB_SYNC_MODE=safe

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Resend email verification
RESEND_API_KEY=
RESEND_FROM_EMAIL="IvoryScribe <onboarding@resend.dev>"

# Optional Tusk AI providers (any subset can be configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

XAI_API_KEY=
XAI_MODEL=grok-4-fast-reasoning

# Stripe billing for Tusk AI activation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TUSK_PRICE_ID=
