PORT=4000
CLIENT_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000
FRONTEND_PUBLIC_URL=http://localhost:5173

# sqlite (default) or postgres
DB_DIALECT=sqlite
# Used when DB_DIALECT=sqlite
DB_STORAGE=./data/ivoryscribe.sqlite

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ivoryscribe
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# safe (default) | alter | force
# safe: never rewrites existing tables
# alter: attempts schema updates (can be risky on sqlite)
# force: drops and recreates all tables
DB_SYNC_MODE=safe

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Resend email verification
RESEND_API_KEY=
RESEND_FROM_EMAIL="IvoryScribe <onboarding@resend.dev>"

# Optional Tusk AI providers (any subset can be configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

XAI_API_KEY=
XAI_MODEL=grok-3-beta

# Stripe billing for Tusk AI activation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TUSK_PRICE_ID=
