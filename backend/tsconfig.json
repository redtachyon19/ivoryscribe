{
  // Type-check only. Node runs the .ts sources directly via type stripping
  // (see package.json scripts and Dockerfile), so nothing is ever emitted —
  // `tsc` here is a linter, not a build step.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    // Sources import each other with explicit .ts specifiers, which is what
    // Node's resolver needs when it is stripping types rather than compiling.
    "allowImportingTsExtensions": true,
    // Type stripping erases annotations but never transforms, so anything that
    // would need codegen (enum, namespace, parameter properties, decorators)
    // must be rejected here rather than at runtime.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
